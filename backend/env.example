PORT=8080
MONGODB_URL=mongodb://localhost:27017/studybuddy

# JWT / AUTH (REQUIRED - Use strong random strings, minimum 32 characters)
JWT_SECRET=your-very-strong-random-secret-minimum-32-characters-long
SESSION_SECRET=your-very-strong-random-session-secret-minimum-32-characters-long
JWT_EXPIRE=7d

# CLIENT BASE URL (for password reset links)
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# SMTP (for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="StudyBuddy" <your-email@example.com>

# GitHub Models API (GPT-4o-mini) - Used for quiz generation, doubt solving, and QPP
# Get your GitHub Personal Access Token from: https://github.com/settings/tokens
# Required scopes: No special scopes needed for GitHub Models API
GITHUB_PAT=your_github_personal_access_token_here

# Legacy Gemini API keys (optional fallback - will use GITHUB_PAT if not set)
# GEMINI_API=your_gemini_api_key_here
# GEMINI_API_DOUBTSOLVER=your_gemini_api_key_here