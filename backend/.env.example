# StudyBuddy Backend Environment Variables
# Copy this file to .env and fill in the actual values

# ======================
# DATABASE & MONGODB
# ======================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ======================
# SERVER CONFIG
# ======================
PORT=8080
NODE_ENV=development
# production environment: change to production

# ======================
# JWT & SECURITY
# ======================
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
SESSION_SECRET=your_session_secret_key_here

# ======================
# CORS & FRONTEND
# ======================
FRONTEND_URL=http://localhost:3000
# For production: https://yourdomain.com

# Allowed origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:3000,https://studybuddy-kc2m.onrender.com

# ======================
# EMAIL CONFIGURATION (SMTP)
# ======================
# Gmail SMTP Example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# For Gmail: use App Password (not regular password)
# Generate here: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=noreply@studybuddy.com

# ======================
# GOOGLE OAUTH
# ======================
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# ======================
# GEMINI AI (Doubt Solver)
# ======================
GEMINI_API_KEY=your_gemini_api_key_here
# Get from: https://ai.google.dev/

# ======================
# OLLAMA (Local AI - Optional)
# ======================
OLLAMA_API_URL=http://localhost:11434/api
OLLAMA_MODEL=llama2

# ======================
# YOUTUBE API (Optional)
# ======================
YOUTUBE_API_KEY=your_youtube_api_key_here

# ======================
# CLOUD STORAGE (Optional - for file uploads)
# ======================
# AWS S3 or similar
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_BUCKET_NAME=studybuddy-uploads
